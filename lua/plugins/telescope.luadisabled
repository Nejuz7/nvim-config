--------------------------------------------------
-- TELESCOPE
--------------------------------------------------

return {

  {
    "nvim-telescope/telescope.nvim",

    cmd = "Telescope",

    dependencies = {

      "nvim-lua/plenary.nvim",

      --------------------------------------------------
      -- FILE BROWSER
      --------------------------------------------------

      "nvim-telescope/telescope-file-browser.nvim",

      --------------------------------------------------
      -- FZF NATIVE
      --------------------------------------------------

      {
        "nvim-telescope/telescope-fzf-native.nvim",

        build =
        "cmake -S. -Bbuild -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release",
      },
    },

    config = function()

      --------------------------------------------------
      -- IMPORTS
      --------------------------------------------------

      local telescope =
          require("telescope")

      local builtin =
          require("telescope.builtin")

      local previewers =
          require("telescope.previewers")

      local actions =
          require("telescope.actions")

      local action_state =
          require("telescope.actions.state")

      --------------------------------------------------
      -- COLORS
      --------------------------------------------------

      local hl =
          vim.api.nvim_set_hl

      local bg =
          "#222224"

      local bg_dark =
          "#0d0d0e"

      local border =
          "#2b2f36"

      local selection =
          "#2a2f38"

      local text =
          "#cdd6f4"

      local muted =
          "#6c7086"

      --------------------------------------------------
      -- GLOBAL UI
      --------------------------------------------------

      hl(0, "NormalFloat", {
        bg = bg,
      })

      hl(0, "FloatBorder", {
        bg = bg,
        fg = border,
      })

      hl(0, "StatusLine", {
        bg = bg,
        fg = text,
      })

      hl(0, "StatusLineNC", {
        bg = bg,
        fg = muted,
      })

      hl(0, "MsgArea", {
        bg = bg,
      })

      hl(0, "CmdLine", {
        bg = bg,
      })

      hl(0, "CmdLineNr", {
        bg = bg,
      })

      hl(0, "WinSeparator", {
        fg = border,
        bg = bg,
      })

      hl(0, "VertSplit", {
        fg = border,
        bg = bg,
      })

      hl(0, "TabLineFill", {
        bg = bg,
      })

      hl(0, "CursorLine", {
        bg = "#1e222a",
      })

      hl(0, "Visual", {
        bg = selection,
      })

      --------------------------------------------------
      -- TELESCOPE
      --------------------------------------------------

      hl(0, "TelescopeNormal", {
        bg = bg,
      })

      hl(0, "TelescopeBorder", {
        bg = bg,
        fg = border,
      })

      hl(0, "TelescopePromptNormal", {
        bg = "#1d222b",
      })

      hl(0, "TelescopePromptBorder", {
        fg = "#1e222a",
        bg = "#1e222a",
      })

      hl(0, "TelescopeResultsNormal", {
        bg = bg,
      })

      hl(0, "TelescopeResultsBorder", {
        bg = bg,
        fg = bg,
      })

      hl(0, "TelescopePreviewNormal", {
        bg = bg,
      })

      hl(0, "TelescopePreviewBorder", {
        bg = bg,
        fg = bg,
      })

      hl(0, "TelescopeSelection", {
        bg = selection,
        fg = text,
        bold = true,
      })

      hl(0, "TelescopeMatching", {
        fg = "#89b4fa",
        bold = true,
      })

      --------------------------------------------------
      -- TITLES
      --------------------------------------------------

      hl(0, "TelescopePromptTitle", {
        bg = "#f7768e",
        fg = bg,
        bold = true,
      })

      hl(0, "TelescopeResultsTitle", {
        bg = "#9ece6a",
        fg = bg,
        bold = true,
      })

      hl(0, "TelescopePreviewTitle", {
        bg = "#9ece6a",
        fg = "#16181d",
        bold = true,
      })

      --------------------------------------------------
      -- FILETYPE PREVIEW FILTER
      --------------------------------------------------

      local allowed = {

        lua = true,
        py = true,
        cpp = true,
        c = true,
        h = true,
        hpp = true,
        rs = true,
        go = true,
        js = true,
        ts = true,
        jsx = true,
        tsx = true,
        html = true,
        css = true,
        json = true,
        yaml = true,
        yml = true,
        toml = true,
        md = true,
        txt = true,
        log = true,
        sh = true,
        ps1 = true,
        java = true,
        cs = true,
        xml = true,
        ini = true,
      }

      --------------------------------------------------
      -- CUSTOM PREVIEWER
      --------------------------------------------------

      local new_maker = function(
        filepath,
        bufnr,
        opts
      )

        filepath =
            vim.fn.expand(filepath)

        local ext =
            filepath:match(
              "^.+%.(.+)$"
            )

        if ext then
          ext = ext:lower()
        end

        if ext and allowed[ext] then

          previewers.buffer_previewer_maker(
            filepath,
            bufnr,
            opts
          )

        else

          vim.schedule(function()

            vim.api.nvim_buf_set_lines(
              bufnr,
              0,
              -1,
              false,
              {

                "",

                " Preview disabled",

                "",

                " Press Ctrl+p for QuickLook",
              }
            )
          end)
        end
      end

      --------------------------------------------------
      -- QUICKLOOK
      --------------------------------------------------

      local external_extensions = {

        png = true,
        jpg = true,
        jpeg = true,
        webp = true,
        gif = true,
        bmp = true,
        mp4 = true,
        mkv = true,
        avi = true,
        mov = true,
        pdf = true,
        mp3 = true,
        wav = true,
        flac = true,
        docx = true,
        pptx = true,
        xlsx = true,
        psd = true,
        ztl = true,
        blend = true,
      }

      local function external_preview(
        prompt_bufnr
      )

        local entry =
            action_state
            .get_selected_entry()

        if not entry then
          return
        end

        local path =
            entry.path
            or entry.filename
            or entry[1]

        if not path then
          return
        end

        local ext =
            path:match(
              "^.+%.(.+)$"
            )

        if ext then
          ext = ext:lower()
        end

        if ext
            and
            external_extensions[ext]
        then

          actions.close(
            prompt_bufnr
          )

          vim.fn.jobstart({

            "C:/Users/naju4/AppData/Local/Programs/QuickLook/QuickLook.exe",

            path,

          }, {

            detach = true,
          })
        end
      end

      --------------------------------------------------
      -- TELESCOPE SETUP
      --------------------------------------------------

      telescope.setup({

        defaults = {

          --------------------------------------------------
          -- PREVIEW
          --------------------------------------------------

          preview = true,

          buffer_previewer_maker =
              new_maker,

          dynamic_preview_title = true,

          
          

          --------------------------------------------------
          -- SEARCH
          --------------------------------------------------

          hidden = true,

          sorting_strategy =
              "ascending",

          path_display = {
            "truncate",
          },

          --------------------------------------------------
          -- LAYOUT
          --------------------------------------------------

          layout_strategy =
              "horizontal",

          layout_config = {

            prompt_position =
                "top",

            horizontal = {

              width = 0.75,

              height = 0.80,

              preview_width = 0.50,
            },

            vertical = {

              width = 0.75,

              height = 0.80,
            },
          },

          --------------------------------------------------
          -- BORDERS
          --------------------------------------------------

          borderchars = 
          {

            " ",
            "  ",
            " ",
            " ",
            " ",
            " ",
            " ",
            " ",
          },

               prompt = {
                "  ",
                "  ",
                " █ ",

                " ",
                " ",
                "  ",
                "  ",
                "  ",
              },




          --------------------------------------------------
          -- UI
          --------------------------------------------------

          winblend = 0,
          winheight = 30,
          winwidth =30,

          prompt_prefix =
              "     ",

          selection_caret =
              " ➜ ",

          entry_prefix =
              "  ",

        

          --------------------------------------------------
          -- PERFORMANCE
          --------------------------------------------------

          file_ignore_patterns = {

            "node_modules",

            ".git/",

            ".cache/",

            ".cargo/",

            "AppData/",

            "DerivedDataCache",

            "Intermediate",

            "Binaries",

            ".vs",

            "%.zip",

            "%.rar",

            "%.7z",

            "%.exe",

            "%.dll",

            "%.iso",
          },


          --------------------------------------------------
          -- KEYMAPS
          --------------------------------------------------

          mappings = {

            i = {

              ["<Esc>"] =
                  actions.close,

              ["<C-p>"] =
                  external_preview,
            },
          },
        },


         pickers = {

      find_files = {
        previewer = false,

        results_title = " Results ",

        layout_config = {
          prompt_position = "top",

          horizontal = {
            width = 0.60,
            height = 0.50,
          },
        },
      },

      buffers = {
        previewer = true,

        layout_config = {
          prompt_position = "top",

          horizontal = {
            width = 0.90,
            height = 0.80,
            preview_width = 0.55,
          },
        },
      },

      find_files = {
        previewer = false,
      },

      live_grep = {
        previewer = true,
      },

      lsp_document_symbols = {
        previewer = true,
      },

      lsp_workspace_symbols = {
        previewer = true,
      },
    },






        --------------------------------------------------
        -- EXTENSIONS
        --------------------------------------------------

        extensions = {

          file_browser = {

            hijack_netrw = true,

            grouped = true,

            hidden = true,

            respect_gitignore =
                true,
          },
        },


        
      })

      




      --------------------------------------------------
      -- LOAD EXTENSIONS
      --------------------------------------------------

      telescope.load_extension(
        "file_browser"
      )

      pcall(
        telescope.load_extension,
        "fzf"
      )

      --------------------------------------------------
      -- FILE BROWSER
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>fe",

        function()

          telescope.extensions
              .file_browser
              .file_browser({

                path = "%:p:h",

                cwd =
                    vim.fn.getcwd(),

                respect_gitignore =
                    true,

                hidden = true,

                grouped = true,

                initial_mode =
                    "normal",
              })
        end,

        {
          desc =
          "File Browser",
        }
      )

      --------------------------------------------------
      -- FIND FILES
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>ff",

        builtin.find_files,

        {
          desc =
          "Find Files",
        }
      )

      --------------------------------------------------
      -- LIVE GREP
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tg",

        builtin.live_grep,

        {
          desc =
          "Live Grep",
        }
      )

      --------------------------------------------------
      -- WORD UNDER CURSOR
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tw",

        builtin.grep_string,

        {
          desc =
          "Find Word",
        }
      )

      --------------------------------------------------
      -- BUFFERS
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tb",

        builtin.buffers,

        {
          desc =
          "Buffers",
        }
      )

      --------------------------------------------------
      -- RECENT FILES
      --------------------------------------------------

vim.keymap.set("n", "<leader>tr", function()
  require("telescope.builtin").oldfiles({
    prompt_title = "  NejuZ Recent ",
  })
end)

      --------------------------------------------------
      -- HELP TAGS
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>th",

        builtin.help_tags,

        {
          desc =
          "Help Tags",
        }
      )

      --------------------------------------------------
      -- KEYMAPS
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tk",

        builtin.keymaps,

        {
          desc =
          "Keymaps",
        }
      )

      --------------------------------------------------
      -- DIAGNOSTICS
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>td",

        builtin.diagnostics,

        {
          desc =
          "Diagnostics",
        }
      )

      --------------------------------------------------
      -- SEARCH CONFIG
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tc",

        function()

          builtin.live_grep({

            cwd =
                vim.fn.stdpath(
                  "config"
                ),
          })
        end,

        {
          desc =
          "Search Config",
        }
      )

      --------------------------------------------------
      -- GIT FILES
      --------------------------------------------------

      vim.keymap.set(
        "n",
        "<leader>tgt",

        function()

          local git_dir =
              vim.fn.finddir(
                ".git",
                ".;"
              )

          if git_dir ~= "" then

            builtin.git_files({

              show_untracked =
                  true,
            })

          else

            builtin.find_files()

          end
        end,

        {
          desc =
          "Git Files",
        }
      )
    end,
  },
}